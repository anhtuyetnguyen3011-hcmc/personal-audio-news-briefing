{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liquid-briefing:schemas:v1:evidence",
  "title": "Evidence / extracted fact, version 1",
  "description": "A candidate factual claim extracted from licensed source material. LLM output is candidate evidence only; verification is a separate action by Agent 3 or a human.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "fact_id",
    "story_id",
    "claim",
    "claim_type",
    "source_article_ids",
    "source_permalinks",
    "evidence_refs",
    "verification_status",
    "confidence",
    "is_model_generated",
    "extraction_method",
    "processing_metadata"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "run_id": { "$ref": "common.schema.json#/$defs/RunId" },
    "fact_id": {
      "type": "string",
      "pattern": "^fact_[A-Za-z0-9_-]{8,96}$",
      "description": "Stable ID derived from story_id + normalized claim + source article IDs."
    },
    "story_id": { "type": "string", "pattern": "^story_[A-Za-z0-9_-]{8,96}$" },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "Paraphrased factual claim. Must not be a copied passage of licensed article text."
    },
    "claim_type": {
      "type": "string",
      "enum": ["claim", "date", "entity", "numerical_value", "source_reference", "event", "quote"]
    },
    "numerical_values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw_value", "context"],
        "properties": {
          "raw_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Exact value string as printed in the source, including separators and sign."
          },
          "normalized_value": { "type": "number" },
          "unit": { "type": "string", "maxLength": 32 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code when a monetary value is present." },
          "precision": { "type": "string", "maxLength": 32 },
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Short paraphrase of what the number refers to; preserves units, currency and comparison context."
          }
        }
      }
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw_value", "normalized_value", "precision"],
        "properties": {
          "raw_value": { "type": "string", "minLength": 1, "maxLength": 64 },
          "normalized_value": { "type": "string", "minLength": 4, "maxLength": 40 },
          "precision": { "type": "string", "enum": ["year", "month", "day", "minute", "second"] },
          "timezone": { "type": "string", "maxLength": 64 },
          "context": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "entity_type"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "entity_type": {
            "type": "string",
            "enum": ["person", "organization", "location", "instrument", "currency", "event", "other"]
          },
          "identifiers": {
            "type": "object",
            "additionalProperties": { "type": "string", "maxLength": 64 },
            "description": "Optional ticker, ISIN, or other stable identifier; never a credential."
          }
        }
      }
    },
    "source_article_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Identifier" },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_permalinks": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" },
      "minItems": 1,
      "description": "Every fact must carry at least one traceable source reference."
    },
    "verification_status": { "$ref": "common.schema.json#/$defs/VerificationStatus" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty_codes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/UncertaintyCode" },
      "uniqueItems": true
    },
    "conflict_with_fact_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^fact_[A-Za-z0-9_-]{8,96}$" },
      "uniqueItems": true
    },
    "is_model_generated": { "type": "boolean" },
    "extraction_method": { "$ref": "common.schema.json#/$defs/ExtractionMethod" },
    "processing_metadata": { "$ref": "common.schema.json#/$defs/ProcessingMetadata" }
  }
}
