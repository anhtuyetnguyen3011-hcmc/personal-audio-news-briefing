{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liquid-briefing:schemas:v1:listener-profile",
  "title": "Listener Profile, version 1",
  "description": "Agent 2 input. Preferences only; contains no article-derived text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "profile_id",
    "label",
    "preferred_language",
    "topics_of_interest",
    "excluded_topics",
    "depth",
    "duration_target_seconds",
    "tone",
    "importance_threshold",
    "max_stories",
    "numerical_detail",
    "timezone",
    "created_at"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "run_id": { "$ref": "common.schema.json#/$defs/RunId" },
    "profile_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "label": { "type": "string", "minLength": 1, "maxLength": 128 },
    "preferred_language": { "$ref": "common.schema.json#/$defs/LanguageCode" },
    "topics_of_interest": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){0,16}$" },
      "uniqueItems": true
    },
    "excluded_topics": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){0,16}$" },
      "uniqueItems": true
    },
    "depth": { "type": "string", "enum": ["brief", "standard", "deep"] },
    "duration_target_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
    "tone": { "type": "string", "enum": ["neutral", "analytical", "conversational", "urgent"] },
    "importance_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "max_stories": { "type": "integer", "minimum": 1, "maximum": 50 },
    "numerical_detail": { "type": "string", "enum": ["minimal", "standard", "full"] },
    "currency_preferences": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{3}$" },
      "uniqueItems": true
    },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
