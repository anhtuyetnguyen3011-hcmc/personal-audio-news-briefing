{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liquid-briefing:schemas:v1:article",
  "title": "Article, version 1",
  "description": "Normalized Agent 1 view of one licensed article. Full article bodies are deliberately excluded: they stay in the local licensed store and are never exported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "article_id",
    "source_feed",
    "language",
    "publication",
    "author",
    "published_at",
    "permalink",
    "headline_normalized",
    "excerpt_normalized",
    "content_hash",
    "text_char_count",
    "processing_metadata"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "run_id": { "$ref": "common.schema.json#/$defs/RunId" },
    "article_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "source_feed": { "type": "string", "minLength": 1, "maxLength": 64 },
    "language": { "$ref": "common.schema.json#/$defs/LanguageCode" },
    "publication": { "type": "string", "minLength": 1, "maxLength": 128 },
    "author": { "type": "string", "maxLength": 256 },
    "published_at": { "type": "string", "format": "date-time" },
    "permalink": { "type": "string", "format": "uri" },
    "headline_normalized": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Whitespace/case normalized headline used as embedding input. Not stored in downstream exports."
    },
    "excerpt_normalized": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2000,
      "description": "Whitespace normalized excerpt used as embedding input. Not stored in downstream exports."
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/Sha256",
      "description": "SHA-256 over normalized headline + '\\n' + normalized excerpt. Cache key = sha256(embedding_model + '\\0' + content_hash)."
    },
    "text_char_count": { "type": "integer", "minimum": 0 },
    "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "provider_categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "company_tickers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "is_translation_candidate": {
      "type": "boolean",
      "description": "True when the article has a same-author counterpart in another language within a short time window."
    },
    "translation_group_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "processing_metadata": { "$ref": "common.schema.json#/$defs/ProcessingMetadata" }
  }
}
